{
  "name": "@bicho-fyi/astro",
  "version": "1.0.0",
  "description": "Bicho browser capture and request error reporting for Astro",
  "keywords": ["astro", "astro-integration", "withastro", "tooling", "bicho", "error-tracking", "observability", "opentelemetry", "ssg", "ssr"],
  "type": "module",
  "license": "Apache-2.0",
  "author": { "name": "FreshJuice", "email": "contact@freshjuice.dev", "url": "https://freshjuice.dev/" },
  "contributors": [{ "name": "Alex Zappa", "email": "alex@zappa.dev", "url": "https://alex.zappa.dev/" }],
  "homepage": "https://bicho.fyi",
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs && node test/matrix.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "@bicho-fyi/javascript": "1.1.0" },
  "peerDependencies": { "astro": "^6.0.0 || ^7.0.0" },
  "devDependencies": { "astro": "7.4.0", "@astrojs/node": "11.1.8", "typescript": "7.0.2", "@types/node": "^24.0.0", "puppeteer-core": "25.14.0" }
}
